# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Server
UNBAKED_API_NETWORK=base-sepolia
UNBAKED_API_FACILITATOR=https://x402.org/facilitator
# Your Base Sepolia receiving address (an address only, never a key).
UNBAKED_API_PAY_TO=
# Most provider spend per UTC day, in dollars (default 5).
UNBAKED_API_DAILY_CAP_USD=5

# Providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# The agent's MCP tool
UNBAKED_API_URL=http://127.0.0.1:8402
# Private key of a throwaway Base Sepolia wallet holding test USDC only.
UNBAKED_WALLET_KEY=
# The most one agent session may spend, in dollars (default 1).
UNBAKED_SESSION_CAP_USD=1
# Where paid pictures and sounds are saved (default unbaked-output).
UNBAKED_OUTPUT_DIR=
